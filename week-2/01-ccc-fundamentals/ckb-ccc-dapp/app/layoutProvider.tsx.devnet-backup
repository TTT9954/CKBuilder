
/* eslint-disable */
"use client";

import { ccc } from "@ckb-ccc/connector-react";
import { CSSProperties } from "react";
import React from "react";

export function LayoutProvider({
    children,
}: {
    children: React.ReactNode;
}) {
    // Connect CCC to local OffCKB Devnet
    const localDevnetClient = React.useMemo(() => {
        return new ccc.ClientPublicTestnet({
            url: "http://127.0.0.1:28114",
        });
    }, []);

    return (
        <ccc.Provider
            connectorProps={{
                style: {
                    "--background": "#232323",
                    "--divider": "rgba(255, 255, 255, 0.1)",
                    "--btn-primary": "#2D2F2F",
                    "--btn-primary-hover": "#515151",
                    "--btn-secondary": "#2D2F2F",
                    "--btn-secondary-hover": "#515151",
                    "--icon-primary": "#FFFFFF",
                    "--icon-secondary": "rgba(255, 255, 255, 0.6)",
                    color: "#ffffff",
                    "--tip-color": "#666",
                } as CSSProperties,
            }}
            defaultClient={localDevnetClient}
            clientOptions={[
                {
                    name: "Local OffCKB Devnet",
                    client: localDevnetClient,
                },
                {
                    name: "CKB Testnet",
                    client: new ccc.ClientPublicTestnet(),
                },
                {
                    name: "CKB Mainnet",
                    client: new ccc.ClientPublicMainnet(),
                },
            ]}
        >
            {children}
        </ccc.Provider>
    );
}